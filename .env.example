VITE_GAME_TYPE=V75
VITE_DEBUG_LOGS=0

# Backend (FastAPI). When API_TOKEN is set, mutating /api requests (POST/PUT/DELETE)
# require the same value in the X-Api-Token header. Reads stay open.
# The frontend picks the token up from VITE_API_TOKEN at build time, or at runtime
# from localStorage.setItem('apiToken', '...').
#API_TOKEN=change-me
#VITE_API_TOKEN=change-me
#DATABASE_URL=postgres://outline:outline@localhost:5432/racewhisperer
