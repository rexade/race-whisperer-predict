VITE_GAME_TYPE=V75
VITE_DEBUG_LOGS=0
# Set at frontend build time when /api persistence is routed to FastAPI.
# The Dockerfile enables this automatically; static deployments leave it unset.
# VITE_PERSISTENCE_API_ENABLED=true

# Backend (FastAPI). Required for every mutating /api request and protected
# debug reads. Leave it empty only when deliberately running the backend read-only.
# Never expose this value through a VITE_* variable; Vite embeds those in public JS.
API_TOKEN=
#DATABASE_URL=postgres://outline:outline@localhost:5432/racewhisperer
